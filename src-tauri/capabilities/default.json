{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "fs:default",
    "fs:allow-app-read-recursive",
    "fs:allow-app-write-recursive",
    "fs:allow-app-read",
    "fs:allow-app-write",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "/**"
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "open-macos",
          "cmd": "open",
          "args": [
            "-a",
            "Preview",
            {
              "validator": ".*"
            }
          ]
        },
        {
          "name": "open-windows",
          "cmd": "start",
          "args": [
            {
              "validator": ".*"
            }
          ]
        },
        {
          "name": "open-linux",
          "cmd": "xdg-open",
          "args": [
            {
              "validator": ".*"
            }
          ]
        }
      ]
    },
    "os:default"
  ]
}
