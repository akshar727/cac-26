{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codely",
    "version": "../package.json",
  "identifier": "com.akshardesai.codely",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:codely.db"]
    }
  },
  "app": {
    "windows": [
      {
        "title": "Codely",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost ipc: http://localhost; img-src 'self' asset: http://asset.localhost data: blob: https://static.blockly.com; connect-src 'self' https://static.blockly.com ipc://localhost; media-src 'self' https://static.blockly.com; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "scope": ["*/**", "$RESOURCE/**/*"],
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["./asset/**/*", "./lesson_assets/**/*"]
  }
}
